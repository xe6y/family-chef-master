# ====== LLM 配置（三选一，优先级：MOONSHOT > Anthropic > OpenAI）======

# 使用 Kimi（Moonshot）— 优先
# 在 https://platform.moonshot.cn/console/api-keys 获取 API Key
# 默认模型：kimi-k2.5（最新旗舰）
# 其他可用模型：kimi-k2-turbo-preview
MOONSHOT_API_KEY=sk-...

# 使用 Anthropic Claude
# 默认模型：claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# 使用 OpenAI
# 默认模型：gpt-5.2
# OPENAI_API_KEY=sk-...


# ====== Cookmate API 配置（用于食材 ID 解析）======

# API 地址（默认本地开发环境）
COOKMATE_API_URL=http://localhost:8080/api

# 方式一：直接提供 JWT Token（优先）
# COOKMATE_TOKEN=eyJhbGci...

# 方式二：账号密码自动登录
COOKMATE_EMAIL=your@email.com
COOKMATE_PASSWORD=your_password
